<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Travel Companion � Explore Beyond the Destination | Kathmandu Valley</title>
  
  <!-- Google Fonts: Plus Jakarta Sans & Playfair Display -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Leaflet CSS & JS for Interactive Mapping -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            serif: ['"Playfair Display"', 'serif'],
          },
          colors: {
            forest: {
              50: '#f2f7f4',
              100: '#e0ede5',
              200: '#c3dbcd',
              300: '#9ac1ac',
              400: '#6ca086',
              500: '#498267',
              600: '#356750',
              700: '#2a5240',
              800: '#234235',
              900: '#1d372c',
              950: '#0f1f18',
            },
            terracotta: {
              50: '#fdf5f3',
              100: '#fbe8e4',
              200: '#f8d5cd',
              300: '#f2b7a9',
              400: '#e88d77',
              500: '#da684c',
              600: '#c64d30',
              700: '#a63d24',
              800: '#8a3521',
              900: '#733020',
            },
            stone: {
              50: '#faf9f6',
              100: '#f3f1ec',
              200: '#e6e2d8',
              300: '#d4cebf',
              800: '#292724',
              900: '#1c1b19',
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #faf9f6;
      color: #1c1b19;
    }
    /* Custom subtle scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #f3f1ec;
    }
    ::-webkit-scrollbar-thumb {
      background: #c3dbcd;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #498267;
    }
    /* Leaflet container fix */
    #interactive-map {
      z-index: 10;
    }
    .leaflet-popup-content-wrapper {
      border-radius: 1rem;
      padding: 4px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15);
    }
    .leaflet-popup-content {
      margin: 10px 12px;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    /* Custom marker styling */
    .custom-pin {
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      color: white;
      font-weight: 700;
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
      border: 2.5px solid white;
      transition: transform 0.2s ease;
    }
    .custom-pin:hover {
      transform: scale(1.15);
    }
  </style>
</head>
<body class="antialiased selection:bg-forest-200 selection:text-forest-950 flex flex-col min-h-screen">

  <!-- Sticky Navigation Header -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-stone-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16 md:h-20">
        <!-- Brand Logo -->
        <button onclick="switchTab('home')" class="flex items-center gap-3 text-left group focus:outline-none">
          <div class="w-10 h-10 rounded-xl bg-forest-800 text-white flex items-center justify-center shadow-md group-hover:bg-terracotta-600 transition-colors">
            <i data-lucide="compass" class="w-6 h-6"></i>
          </div>
          <div>
            <span class="font-serif font-bold text-lg sm:text-xl text-forest-950 tracking-tight block leading-none">Travel Companion</span>
            <span class="text-[11px] font-medium text-terracotta-700 uppercase tracking-wider">Kathmandu Valley Pilot</span>
          </div>
        </button>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-1 lg:gap-2">
          <button onclick="switchTab('home')" data-nav="home" class="nav-btn px-3.5 py-2 rounded-xl text-sm font-semibold transition-all bg-forest-50 text-forest-800">
            Explore
          </button>
          <button onclick="switchTab('routes')" data-nav="routes" class="nav-btn px-3.5 py-2 rounded-xl text-sm font-semibold text-stone-600 hover:text-forest-800 hover:bg-stone-100 transition-all">
            Route Explorer
          </button>
          <button onclick="switchTab('destinations')" data-nav="destinations" class="nav-btn px-3.5 py-2 rounded-xl text-sm font-semibold text-stone-600 hover:text-forest-800 hover:bg-stone-100 transition-all">
            Destinations
          </button>
          <button onclick="switchTab('hiking')" data-nav="hiking" class="nav-btn px-3.5 py-2 rounded-xl text-sm font-semibold text-stone-600 hover:text-forest-800 hover:bg-stone-100 transition-all">
            Hiking & Trails
          </button>
          <button onclick="switchTab('map')" data-nav="map" class="nav-btn px-3.5 py-2 rounded-xl text-sm font-semibold text-stone-600 hover:text-forest-800 hover:bg-stone-100 transition-all flex items-center gap-1.5">
            <i data-lucide="map-pin" class="w-4 h-4 text-terracotta-600"></i>
            Interactive Map
          </button>
        </nav>

        <!-- Scope Indicator & Mobile Menu Button -->
        <div class="flex items-center gap-2">
          <span class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-stone-100 text-stone-700 border border-stone-200" title="Modular database scoped to Kathmandu Valley with Nepal expansion ready">
            <span class="w-2 h-2 rounded-full bg-forest-600"></span>
            Region: Kathmandu Valley
          </span>
          <button id="mobile-menu-btn" onclick="toggleMobileMenu()" class="md:hidden p-2.5 rounded-xl text-stone-700 hover:bg-stone-100 focus:outline-none" aria-label="Toggle Menu">
            <i data-lucide="menu" class="w-6 h-6"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-stone-200 px-4 pt-2 pb-4 space-y-1.5 shadow-lg">
      <button onclick="switchTab('home'); toggleMobileMenu()" data-nav="home" class="nav-btn w-full text-left px-4 py-3 rounded-xl text-sm font-semibold bg-forest-50 text-forest-800 flex items-center gap-3">
        <i data-lucide="home" class="w-4 h-4"></i> Explore Home
      </button>
      <button onclick="switchTab('routes'); toggleMobileMenu()" data-nav="routes" class="nav-btn w-full text-left px-4 py-3 rounded-xl text-sm font-semibold text-stone-700 hover:bg-stone-100 flex items-center gap-3">
        <i data-lucide="navigation" class="w-4 h-4"></i> Route Explorer
      </button>
      <button onclick="switchTab('destinations'); toggleMobileMenu()" data-nav="destinations" class="nav-btn w-full text-left px-4 py-3 rounded-xl text-sm font-semibold text-stone-700 hover:bg-stone-100 flex items-center gap-3">
        <i data-lucide="landmark" class="w-4 h-4"></i> Destinations Guide
      </button>
      <button onclick="switchTab('hiking'); toggleMobileMenu()" data-nav="hiking" class="nav-btn w-full text-left px-4 py-3 rounded-xl text-sm font-semibold text-stone-700 hover:bg-stone-100 flex items-center gap-3">
        <i data-lucide="mountain" class="w-4 h-4"></i> Hiking & Adventure
      </button>
      <button onclick="switchTab('map'); toggleMobileMenu()" data-nav="map" class="nav-btn w-full text-left px-4 py-3 rounded-xl text-sm font-semibold text-stone-700 hover:bg-stone-100 flex items-center gap-3">
        <i data-lucide="map" class="w-4 h-4 text-terracotta-600"></i> Interactive Map
      </button>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="flex-grow">

    <!-- ==================== VIEW 1: HOME / EXPLORE ==================== -->
    <section id="view-home" class="tab-view space-y-14 pb-16">
      
      <!-- Hero Banner -->
      <div class="relative bg-forest-950 text-white overflow-hidden">
        <div class="absolute inset-0">
          <img 
            src="https://images.unsplash.com/photo-1544735716-392fe2489ffa?auto=format&fit=crop&w=1920&q=80" 
            alt="Kathmandu Valley Stupa and Himalayan foothills" 
            class="w-full h-full object-cover opacity-40"
            onerror="this.style.display='none'"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-forest-950 via-forest-950/70 to-forest-900/40"></div>
        </div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 lg:py-28">
          <div class="max-w-3xl space-y-6">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs sm:text-sm font-medium text-forest-100">
              <i data-lucide="sparkles" class="w-4 h-4 text-terracotta-400"></i>
              Explore Beyond the Destination � Kathmandu, Lalitpur & Bhaktapur
            </div>
            <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-tight">
              Navigate Heritage Streets & Himalayan Rim Trails.
            </h1>
            <p class="text-base sm:text-lg text-stone-200 leading-relaxed max-w-2xl">
              Plan realistic road journeys, discover ancient Newar towns, check transparent cost & elevation estimates, and uncover nearby gems across Kathmandu Valley.
            </p>

            <!-- Instant Search Bar -->
            <div class="pt-2">
              <div class="relative max-w-2xl">
                <div class="flex items-center bg-white rounded-2xl shadow-xl p-2 border border-stone-200 focus-within:ring-2 focus-within:ring-terracotta-500">
                  <i data-lucide="search" class="w-5 h-5 text-stone-400 ml-3 mr-2 shrink-0"></i>
                  <input 
                    type="text" 
                    id="hero-search-input" 
                    oninput="handleHeroSearch(this.value)"
                    placeholder="Search Dakshinkali, Champadevi Hiking, Bhaktapur, Nagarkot..." 
                    class="w-full py-2.5 px-2 text-stone-900 placeholder-stone-400 text-sm sm:text-base focus:outline-none bg-transparent"
                  />
                  <button onclick="handleHeroSearch(document.getElementById('hero-search-input').value)" class="px-5 py-2.5 bg-terracotta-600 hover:bg-terracotta-700 text-white font-semibold text-sm rounded-xl transition-colors shrink-0">
                    Explore
                  </button>
                </div>

                <!-- Instant Search Results Dropdown -->
                <div id="hero-search-results" class="hidden absolute left-0 right-0 mt-2 bg-white rounded-2xl shadow-2xl border border-stone-200 overflow-hidden z-30 max-h-96 overflow-y-auto text-stone-900">
                  <!-- Populated dynamically via JS -->
                </div>
              </div>

              <!-- Quick Search Pills -->
              <div class="flex flex-wrap items-center gap-2 mt-4 text-xs">
                <span class="text-stone-300 font-medium">Popular searches:</span>
                <button onclick="openDestinationModal('dakshinkali')" class="px-3 py-1 rounded-full bg-white/15 hover:bg-white/25 text-white transition">Dakshinkali Temple</button>
                <button onclick="openHikingModal('champadevi')" class="px-3 py-1 rounded-full bg-white/15 hover:bg-white/25 text-white transition">Champadevi Hiking</button>
                <button onclick="openDestinationModal('bhaktapur')" class="px-3 py-1 rounded-full bg-white/15 hover:bg-white/25 text-white transition">Bhaktapur Durbar</button>
                <button onclick="quickPlanRoute('thamel', 'dakshinkali')" class="px-3 py-1 rounded-full bg-terracotta-600/80 hover:bg-terracotta-600 text-white transition">Route: Thamel ? Dakshinkali</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Data Transparency & Scope Banner -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-2xl p-5 sm:p-6 border border-stone-200 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div class="flex items-start gap-3.5">
            <div class="p-2.5 rounded-xl bg-forest-50 text-forest-700 shrink-0 mt-0.5">
              <i data-lucide="shield-check" class="w-5 h-5"></i>
            </div>
            <div>
              <h2 class="text-sm font-bold text-stone-900">Transparent Travel Data Guarantee</h2>
              <p class="text-xs sm:text-sm text-stone-600 mt-0.5">
                We distinguish verified heritage facts & elevations from estimated travel times, fare ranges, and unavailable live traffic feeds.
              </p>
            </div>
          </div>
          <div class="flex flex-wrap gap-2 shrink-0 text-xs font-semibold">
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200">
              <i data-lucide="check-circle-2" class="w-3.5 h-3.5"></i> Verified Fact
            </span>
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-amber-50 text-amber-800 border border-amber-200">
              <i data-lucide="clock" class="w-3.5 h-3.5"></i> Estimated Range
            </span>
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-stone-100 text-stone-700 border border-stone-300">
              <i data-lucide="info" class="w-3.5 h-3.5"></i> Live Data Unavailable
            </span>
          </div>
        </div>
      </div>

      <!-- Quick Action Cards -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div onclick="switchTab('routes')" class="cursor-pointer group bg-white rounded-2xl p-6 border border-stone-200 shadow-sm hover:shadow-md hover:border-forest-300 transition-all">
            <div class="w-12 h-12 rounded-2xl bg-forest-100 text-forest-800 flex items-center justify-center mb-4 group-hover:bg-forest-800 group-hover:text-white transition-colors">
              <i data-lucide="route" class="w-6 h-6"></i>
            </div>
            <h3 class="font-serif text-xl font-bold text-stone-900 mb-2">Smart Route Explorer</h3>
            <p class="text-sm text-stone-600 mb-4">Compare bike, car/taxi, public microbus, and walking routes with landmarks, stops, and estimated NPR fares.</p>
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-forest-700 group-hover:translate-x-1 transition-transform">
              Plan a Route <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </span>
          </div>

          <div onclick="switchTab('hiking')" class="cursor-pointer group bg-white rounded-2xl p-6 border border-stone-200 shadow-sm hover:shadow-md hover:border-terracotta-300 transition-all">
            <div class="w-12 h-12 rounded-2xl bg-terracotta-100 text-terracotta-700 flex items-center justify-center mb-4 group-hover:bg-terracotta-600 group-hover:text-white transition-colors">
              <i data-lucide="mountain-snow" class="w-6 h-6"></i>
            </div>
            <h3 class="font-serif text-xl font-bold text-stone-900 mb-2">Valley Rim Hiking</h3>
            <p class="text-sm text-stone-600 mb-4">Detailed trail guides for Champadevi, Shivapuri, Nagarjun, and Nagarkot with elevation gain and gear checklists.</p>
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-terracotta-700 group-hover:translate-x-1 transition-transform">
              Explore Trails <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </span>
          </div>

          <div onclick="switchTab('map')" class="cursor-pointer group bg-white rounded-2xl p-6 border border-stone-200 shadow-sm hover:shadow-md hover:border-forest-300 transition-all">
            <div class="w-12 h-12 rounded-2xl bg-stone-100 text-stone-800 flex items-center justify-center mb-4 group-hover:bg-stone-800 group-hover:text-white transition-colors">
              <i data-lucide="map-pinned" class="w-6 h-6"></i>
            </div>
            <h3 class="font-serif text-xl font-bold text-stone-900 mb-2">Interactive Valley Map</h3>
            <p class="text-sm text-stone-600 mb-4">Visualize heritage sites, route polylines, hiking trailheads, and nearby attractions across Kathmandu Valley.</p>
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-stone-800 group-hover:translate-x-1 transition-transform">
              Open Map <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </span>
          </div>
        </div>
      </div>

      <!-- Featured Destinations Grid -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-terracotta-600">Cultural & Scenic Gems</span>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900 mt-1">Popular Valley Destinations</h2>
          </div>
          <button onclick="switchTab('destinations')" class="text-sm font-semibold text-forest-700 hover:text-forest-900 inline-flex items-center gap-1">
            View all 10 destinations <i data-lucide="chevron-right" class="w-4 h-4"></i>
          </button>
        </div>

        <div id="home-featured-destinations" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Rendered by JS -->
        </div>
      </div>

      <!-- Featured Hiking & Adventure -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-forest-700">Rim Trails & Day Hikes</span>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900 mt-1">Hiking & Adventure Recommendations</h2>
          </div>
          <button onclick="switchTab('hiking')" class="text-sm font-semibold text-forest-700 hover:text-forest-900 inline-flex items-center gap-1">
            View all trail guides <i data-lucide="chevron-right" class="w-4 h-4"></i>
          </button>
        </div>

        <div id="home-featured-hiking" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Rendered by JS -->
        </div>
      </div>

    </section>

    <!-- ==================== VIEW 2: ROUTE EXPLORER ==================== -->
    <section id="view-routes" class="tab-view hidden py-10 sm:py-14">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
        
        <!-- Header -->
        <div class="max-w-3xl">
          <span class="text-xs font-bold uppercase tracking-wider text-terracotta-600">Journey Planner</span>
          <h1 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 mt-1">Kathmandu Valley Route Explorer</h1>
          <p class="text-stone-600 mt-2 text-sm sm:text-base">
            Select your starting hub, destination, and transport mode to inspect distances, corridor landmarks, road notes, estimated NPR costs, and nearby places worth adding to your trip.
          </p>
        </div>

        <!-- Route Configuration Card -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-stone-200 shadow-sm">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-5 items-end">
            
            <!-- Starting Location -->
            <div class="md:col-span-4 space-y-2">
              <label for="route-origin" class="block text-xs font-bold uppercase tracking-wider text-stone-600">
                Starting Location
              </label>
              <div class="relative">
                <select id="route-origin" onchange="calculateAndRenderRoute()" class="w-full appearance-none rounded-xl border border-stone-300 bg-stone-50 px-4 py-3.5 pr-10 text-sm font-semibold text-stone-900 focus:border-forest-600 focus:bg-white focus:outline-none">
                  <!-- Populated by JS -->
                </select>
                <i data-lucide="map-pin" class="w-4 h-4 text-forest-700 absolute right-3.5 top-4 pointer-events-none"></i>
              </div>
            </div>

            <!-- Swap Button -->
            <div class="md:col-span-1 flex justify-center">
              <button onclick="swapRouteLocations()" title="Swap locations" class="p-3 rounded-xl border border-stone-200 bg-stone-50 hover:bg-forest-50 hover:border-forest-300 text-stone-700 transition">
                <i data-lucide="arrow-left-right" class="w-5 h-5"></i>
              </button>
            </div>

            <!-- Destination -->
            <div class="md:col-span-4 space-y-2">
              <label for="route-destination" class="block text-xs font-bold uppercase tracking-wider text-stone-600">
                Destination
              </label>
              <div class="relative">
                <select id="route-destination" onchange="calculateAndRenderRoute()" class="w-full appearance-none rounded-xl border border-stone-300 bg-stone-50 px-4 py-3.5 pr-10 text-sm font-semibold text-stone-900 focus:border-forest-600 focus:bg-white focus:outline-none">
                  <!-- Populated by JS -->
                </select>
                <i data-lucide="flag" class="w-4 h-4 text-terracotta-600 absolute right-3.5 top-4 pointer-events-none"></i>
              </div>
            </div>

            <!-- Quick Preset Button -->
            <div class="md:col-span-3">
              <button onclick="calculateAndRenderRoute()" class="w-full py-3.5 px-5 rounded-xl bg-forest-800 hover:bg-forest-900 text-white font-semibold text-sm shadow-sm transition flex items-center justify-center gap-2">
                <i data-lucide="compass" class="w-4 h-4"></i> Update Route
              </button>
            </div>
          </div>

          <!-- Preferred Mode of Transportation Pills -->
          <div class="mt-6 pt-6 border-t border-stone-100">
            <span class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-3">Preferred Mode of Transportation</span>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="transport-mode-selector">
              <button type="button" onclick="selectTransportMode('bike')" data-mode="bike" class="mode-btn flex items-center justify-center gap-2.5 p-3.5 rounded-xl border-2 border-forest-700 bg-forest-50 text-forest-900 font-semibold text-sm transition">
                <i data-lucide="bike" class="w-5 h-5 text-forest-700"></i> Bike / Scooter
              </button>
              <button type="button" onclick="selectTransportMode('car')" data-mode="car" class="mode-btn flex items-center justify-center gap-2.5 p-3.5 rounded-xl border border-stone-200 bg-white text-stone-700 hover:bg-stone-50 font-semibold text-sm transition">
                <i data-lucide="car" class="w-5 h-5 text-stone-500"></i> Car / Taxi
              </button>
              <button type="button" onclick="selectTransportMode('bus')" data-mode="bus" class="mode-btn flex items-center justify-center gap-2.5 p-3.5 rounded-xl border border-stone-200 bg-white text-stone-700 hover:bg-stone-50 font-semibold text-sm transition">
                <i data-lucide="bus" class="w-5 h-5 text-stone-500"></i> Public Bus / Micro
              </button>
              <button type="button" onclick="selectTransportMode('walking')" data-mode="walking" class="mode-btn flex items-center justify-center gap-2.5 p-3.5 rounded-xl border border-stone-200 bg-white text-stone-700 hover:bg-stone-50 font-semibold text-sm transition">
