      const q = query.trim().toLowerCase();

      if (!q) {
        dropdown.classList.add('hidden');
        return;
      }

      const region = NEPAL_TRAVEL_DB.regions[NEPAL_TRAVEL_DB.activeRegion];
      const destMatches = Object.values(region.destinations).filter(d =>
        d.name.toLowerCase().includes(q) ||
        d.district.toLowerCase().includes(q) ||
        d.category.toLowerCase().includes(q) ||
        d.tagline.toLowerCase().includes(q)
      );

      const hikeMatches = Object.values(region.hikingTrails).filter(h =>
        h.name.toLowerCase().includes(q) ||
        h.district.toLowerCase().includes(q) ||
        h.subtitle.toLowerCase().includes(q)
      );

      if (destMatches.length === 0 && hikeMatches.length === 0) {
        dropdown.innerHTML = `
          <div class="p-4 text-sm text-stone-500 text-center">
            No Kathmandu Valley matches for "<strong>${escapeHtml(query)}</strong>". Try <em>Dakshinkali</em>, <em>Champadevi</em>, <em>Bhaktapur</em>, or <em>Nagarkot</em>.
          </div>
        `;
        dropdown.classList.remove('hidden');
        return;
      }

      let html = '';

      if (destMatches.length > 0) {
        html += `<div class="px-4 py-2 bg-stone-50 text-[11px] font-bold uppercase tracking-wider text-stone-500 border-b border-stone-100">Destinations (${destMatches.length})</div>`;
        destMatches.forEach(d => {
