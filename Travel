        const searchBox = document.getElementById('hero-search-input');
        const dropdown = document.getElementById('hero-search-results');
        if (searchBox && dropdown && !searchBox.contains(e.target) && !dropdown.contains(e.target)) {
          dropdown.classList.add('hidden');
        }
      });
