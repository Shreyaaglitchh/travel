    // Haversine helper for realistic valley corridor estimation when pair isn't hardcoded
    function haversineKm(coord1, coord2) {
      const R = 6371;
      const dLat = (coord2[0] - coord1[0]) * Math.PI / 180;
      const dLon = (coord2[1] - coord1[1]) * Math.PI / 180;
      const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(coord1[0] * Math.PI / 180) * Math.cos(coord2[0] * Math.PI / 180) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    function getRouteData(originId, destId) {
      const region = NEPAL_TRAVEL_DB.regions[NEPAL_TRAVEL_DB.activeRegion];
      const origin = region.hubs.find(h => h.id === originId);
      const dest = region.hubs.find(h => h.id === destId);

      if (!origin || !dest) return null;

      if (originId === destId) {
        return {
          sameLocation: true,
          origin,
          dest
        };
      }

      const key = `${originId}__${destId}`;
      const reverseKey = `${destId}__${originId}`;

      if (region.routes[key]) {
        return { ...region.routes[key], origin, dest, isSynthesized: false };
      }
      if (region.routes[reverseKey]) {
        const rev = region.routes[reverseKey];
        return {
          ...rev,
          origin,
          dest,
          waypoints: [...rev.waypoints].reverse(),
          isSynthesized: false
        };
      }

      // Synthesize a realistic Kathmandu Valley corridor estimate
      const straightKm = haversineKm(origin.coords, dest.coords);
      const roadKm = Math.max(2.5, +(straightKm * 1.38).toFixed(1)); // Valley road winding factor
      const destDetail = region.destinations[destId];

      const bikeMin = Math.round(roadKm * 2.4 + 8);
      const bikeMax = Math.round(roadKm * 3.4 + 15);
      const carMin = Math.round(roadKm * 2.7 + 10);
      const carMax = Math.round(roadKm * 4.0 + 20);
      const busMin = Math.round(roadKm * 3.8 + 15);
      const busMax = Math.round(roadKm * 5.2 + 25);
      const walkHoursMin = +(roadKm / 4.2).toFixed(1);
      const walkHoursMax = +(roadKm / 3.3).toFixed(1);

      const taxiLow = Math.round((roadKm * 65 + 150) / 50) * 50;
      const taxiHigh = Math.round((roadKm * 95 + 250) / 50) * 50;
      const busFare = roadKm < 8 ? 'NPR 25 � 40' : roadKm < 18 ? 'NPR 45 � 75' : 'NPR 70 � 130';

      const midLat = (origin.coords[0] + dest.coords[0]) / 2 + 0.004;
      const midLng = (origin.coords[1] + dest.coords[1]) / 2 - 0.004;

      return {
        origin,
        dest,
        isSynthesized: true,
        distanceKm: `~${roadKm} km (estimated road distance)`,
        durations: {
          bike: `${bikeMin} � ${bikeMax} mins (estimated)`,
          car: `${carMin} � ${carMax} mins (estimated)`,
          bus: `${busMin} � ${busMax} mins (estimated, may require Ring Road / Ratna Park transfer)`,
          walking: `${walkHoursMin} � ${walkHoursMax} hours (estimated)`
        },
        costs: {
          bike: `NPR ${Math.round(roadKm * 11)} � ${Math.round(roadKm * 16)} (est. fuel) / Ride-share bike varies`,
          car: `NPR ${taxiLow.toLocaleString()} � ${taxiHigh.toLocaleString()} (estimated metered/ride-share taxi range)`,
          bus: `${busFare} (estimated local microbus/Sajha Yatayat range)`,
          walking: 'Free'
        },
        corridor: `${origin.name.split('(')[0].trim()} ? Ring Road / Valley Arterial Corridor ? ${dest.name.split('(')[0].trim()}`,
        landmarks: [
          `${origin.district} urban arterial junction`,
          'Kathmandu Ring Road / Bagmati River bridge crossing',
          destDetail ? destDetail.mainAttractions[0] : `${dest.district} local bazaar`
        ],
        roadConditions: {
          verified: 'Primary valley roads are paved blacktop; final approaches to hilltop temples or outskirts may involve steeper, narrower two-lane segments.',
          unavailable: 'Live traffic congestion, road construction diversions, and exact microbus departure intervals are unavailable.'
        },
        recommendedStops: destDetail && destDetail.nearbyPlaces
          ? destDetail.nearbyPlaces.slice(0, 2).map(nId => {
              const nd = region.destinations[nId] || region.hikingTrails[nId];
              return {
                name: nd ? nd.name : nId,
                reason: nd ? (nd.tagline || nd.subtitle) : 'Nearby valley attraction',
                destId: region.destinations[nId] ? nId : null,
                hikeId: region.hikingTrails[nId] ? nId : null
              };
            })
          : [],
        nearbySuggestions: destDetail ? (destDetail.nearbyPlaces || []) : ['patan', 'bhaktapur', 'swayambhunath'],
        waypoints: [origin.coords, [midLat, midLng], dest.coords]
      };
    }

