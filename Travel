    // ==================== NAVIGATION & VIEW SWITCHING ====================
    function switchTab(tabName) {
      appState.activeTab = tabName;

      // Hide all views
      document.querySelectorAll('.tab-view').forEach(el => el.classList.add('hidden'));
      const targetView = document.getElementById(`view-${tabName}`);
      if (targetView) targetView.classList.remove('hidden');

      // Update nav button active states
      document.querySelectorAll('.nav-btn').forEach(btn => {
        if (btn.dataset.nav === tabName) {
          btn.classList.remove('text-stone-600', 'text-stone-700', 'hover:bg-stone-100');
          btn.classList.add('bg-forest-50', 'text-forest-800');
        } else {
          btn.classList.remove('bg-forest-50', 'text-forest-800');
          btn.classList.add('text-stone-600', 'hover:bg-stone-100');
        }
      });

      window.scrollTo({ top: 0, behavior: 'smooth' });

      // Initialize or refresh Leaflet map when Map tab opens
      if (tabName === 'map') {
        setTimeout(() => {
          initOrUpdateMap();
        }, 100);
      }

      lucide.createIcons();
    }

    function toggleMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      menu.classList.toggle('hidden');
    }

