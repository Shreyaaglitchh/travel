    // ==================== INTERACTIVE LEAFLET MAP ====================
    function initOrUpdateMap() {
      if (!appState.mapInstance) {
        // Center on Kathmandu Valley
        appState.mapInstance = L.map('interactive-map').setView([27.6915, 85.3420], 11);

        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
          attribution: '&copy; OpenStreetMap &copy; CARTO',
          subdomains: 'abcd',
          maxZoom: 18
        }).addTo(appState.mapInstance);

        appState.mapLayerGroup = L.layerGroup().addTo(appState.mapInstance);
        appState.routeLayerGroup = L.layerGroup().addTo(appState.mapInstance);
      }

      appState.mapInstance.invalidateSize();
      renderMapMarkersAndRoute();
    }

    function setMapFilter(filterType) {
      appState.mapFilter = filterType;
      document.querySelectorAll('.map-filter-btn').forEach(btn => {
        if (btn.dataset.mapfilter === filterType) {
          btn.className = 'map-filter-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-forest-800 text-white shadow-sm transition';
        } else {
          btn.className = 'map-filter-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-white border border-stone-200 text-stone-700 hover:bg-stone-50 transition';
        }
      });
      renderMapMarkersAndRoute();
    }

    function createCustomPinIcon(colorHex, labelChar) {
      return L.divIcon({
        className: '',
        html: `<div class="custom-pin" style="background-color:${colorHex}; width:30px; height:30px; font-size:12px;">${labelChar}</div>`,
        iconSize: [30, 30],
        iconAnchor: [15, 15],
        popupAnchor: [0, -14]
      });
    }

    function renderMapMarkersAndRoute() {
      if (!appState.mapInstance) return;

      appState.mapLayerGroup.clearLayers();
      appState.routeLayerGroup.clearLayers();

      const region = NEPAL_TRAVEL_DB.regions[NEPAL_TRAVEL_DB.activeRegion];
      const filter = appState.mapFilter;

      // 1. Render Destinations Markers
      if (filter === 'all' || filter === 'heritage') {
        Object.values(region.destinations).forEach(d => {
          const marker = L.marker(d.coords, {
            icon: createCustomPinIcon('#2a5240', 'D')
          });
          marker.bindPopup(`
            <div class="min-w-[200px] space-y-1.5">
              <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded">${d.category}</span>
              <h4 class="font-bold text-sm text-stone-900">${d.name}</h4>
              <p class="text-xs text-stone-600">${d.tagline}</p>
              <div class="pt-1 flex gap-1.5">
                <button onclick="openDestinationModal('${d.id}')" class="flex-1 py-1.5 px-2.5 rounded-lg bg-forest-800 text-white text-xs font-bold">Guide</button>
                <button onclick="quickPlanRoute('thamel', '${d.id}')" class="py-1.5 px-2.5 rounded-lg bg-stone-100 text-stone-800 text-xs font-bold">Route</button>
              </div>
            </div>
          `);
          appState.mapLayerGroup.addLayer(marker);
        });
      }

      // 2. Render Hiking Trail Markers & Trail Lines
      if (filter === 'all' || filter === 'hiking') {
        Object.values(region.hikingTrails).forEach(h => {
          const peakMarker = L.marker(h.coords, {
            icon: createCustomPinIcon('#c64d30', '?')
          });
          peakMarker.bindPopup(`
            <div class="min-w-[200px] space-y-1.5">
              <span class="text-[10px] font-bold uppercase tracking-wider text-terracotta-800 bg-terracotta-50 px-2 py-0.5 rounded">${h.difficulty} � ${h.summitElevation}</span>
              <h4 class="font-bold text-sm text-stone-900">${h.name}</h4>
              <p class="text-xs text-stone-600">${h.distance} � ${h.uphillDuration}</p>
              <button onclick="openHikingModal('${h.id}')" class="w-full mt-1 py-1.5 px-2.5 rounded-lg bg-terracotta-600 text-white text-xs font-bold">Open Trail Guide</button>
            </div>
          `);
          appState.mapLayerGroup.addLayer(peakMarker);

          if (h.trailheadCoords) {
            const trailLine = L.polyline([h.trailheadCoords, h.coords], {
              color: '#c64d30',
              weight: 3,
              dashArray: '6, 6',
              opacity: 0.85
            });
            appState.mapLayerGroup.addLayer(trailLine);
          }
        });
      }

      // 3. Render Transit Hubs
      if (filter === 'all') {
        region.hubs.filter(h => h.type === 'hub').forEach(hub => {
          const hubMarker = L.marker(hub.coords, {
            icon: createCustomPinIcon('#d97706', 'H')
          });
          hubMarker.bindPopup(`
            <div class="space-y-1">
              <span class="text-[10px] font-bold uppercase text-amber-800">Transit / Start Hub</span>
              <h4 class="font-bold text-sm text-stone-900">${hub.name}</h4>
            </div>
          `);
          appState.mapLayerGroup.addLayer(hubMarker);
        });
      }

      // 4. Always draw active Route Explorer corridor
      drawActiveRouteOnMap(filter === 'route');
    }

    function drawActiveRouteOnMap(fitBounds = false) {
      if (!appState.mapInstance || !appState.routeLayerGroup) return;
      appState.routeLayerGroup.clearLayers();

      const routeData = getRouteData(appState.originId, appState.destinationId);
      if (!routeData || routeData.sameLocation || !routeData.waypoints) return;

      const polyline = L.polyline(routeData.waypoints, {
        color: '#c64d30',
        weight: 5,
        opacity: 0.9
      }).addTo(appState.routeLayerGroup);

      const startMarker = L.marker(routeData.origin.coords, {
        icon: createCustomPinIcon('#1d372c', 'S')
      }).bindPopup(`<strong>Start:</strong> ${routeData.origin.name}`);

      const endMarker = L.marker(routeData.dest.coords, {
        icon: createCustomPinIcon('#c64d30', 'E')
      }).bindPopup(`<strong>Destination:</strong> ${routeData.dest.name}<br/><span class="text-xs">${routeData.distanceKm}</span>`);

      appState.routeLayerGroup.addLayer(startMarker);
      appState.routeLayerGroup.addLayer(endMarker);

      if (fitBounds) {
        appState.mapInstance.fitBounds(polyline.getBounds(), { padding: [50, 50] });
      }
    }

    function viewActiveRouteOnMap() {
      switchTab('map');
      setTimeout(() => {
        setMapFilter('route');
        drawActiveRouteOnMap(true);
      }, 150);
    }

    function focusItemOnMap(lat, lng, title) {
      switchTab('map');
      setTimeout(() => {
        setMapFilter('all');
        appState.mapInstance.setView([lat, lng], 14);
        L.popup()
          .setLatLng([lat, lng])
          .setContent(`<div class="font-bold text-sm text-stone-900">${escapeHtml(title)}</div>`)
          .openOn(appState.mapInstance);
      }, 150);
    }

    // Security helper for search input
    function escapeHtml(str) {
      return str.replace(/[&<>"']/g, function(m) {
        return ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;'
        })[m];
      });
    }
  </script>
</body>
</html>
